# ===================================
# Unreal Engine .gitignore
# GameEngine2-GroupProject
# ===================================

# Visual Studio / IDE files
.vs/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Compiled source / object files
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# ===================================
# Engine-generated folders
# (the ** ensures everything nested
# inside is ignored, not just the
# top level — this was the bug)
# ===================================
Binaries/**
Plugins/**/Binaries/**
Build/**
!Build/*/
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

Intermediate/**
Plugins/**/Intermediate/**

DerivedDataCache/**

Saved/**

# Built data for maps
*_BuiltData.uasset

# ===================================
# Editor / crash reporter / webcache
# (covers CrashReportClient, cef3
# logs, AutoScreenshot.png, and the
# whole webcache_* CEF browser cache
# tree seen in Saved/)
# ===================================
**/Saved/webcache*/**
**/Saved/Logs/**
**/Saved/Crashes/**
**/Saved/AutoScreenshot.png
**/Saved/Config/**/CrashReportClient.ini

# ===================================
# Extra safety net: catch any nested
# Saved/ or Intermediate/ folder that
# might exist under a plugin, sample,
# or nested project
# ===================================
**/Saved/
**/Intermediate/
**/DerivedDataCache/
**/Binaries/
